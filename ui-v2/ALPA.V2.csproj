<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ALPA UI v2  (Amazing Latency Performance Audit - readable UI rework)

    版本隔离策略：本工程位于 ui-v2/ 子目录，与仓库根目录的原版 Program.cs /
    Program.csproj 完全互不干扰（SDK 默认只 glob 本目录下的 *.cs，
    不会把 ../Program.cs 编译进来）。原版可用 root/comp.bat 单独构建。

    目标框架保持 net48，与上游一致，因此仓库根目录的 TraceEvent 等依赖 DLL
    可以原样复用，引擎行为不变，本次改动只涉及 UI 层与数据聚合方式。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ALP2</RootNamespace>
    <AssemblyName>ALPA_v2</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AssemblyTitle>ALPA v2 - Latency &amp; DPC Audit</AssemblyTitle>
    <Product>ALPA v2</Product>
    <Description>Readable light-theme UI rework of ALPA (Amazing Latency Performance Audit).</Description>
    <Version>2.1.6</Version>
    <FileVersion>2.1.6.0</FileVersion>
    <AssemblyVersion>2.1.6.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS1591</NoWarn>
    <!-- 输出到 ui-v2/build，随后由 build-v2.bat 汇总到 dist/ -->
    <OutputPath>build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 本机无 VS / 无 .NET Framework 开发包时，用它提供 net48 引用程序集 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration" />
    <Reference Include="netstandard" />
  </ItemGroup>

  <!-- 复用上游仓库根目录里已经随包发布的依赖，不重新打包 -->
  <ItemGroup>
    <Reference Include="Microsoft.Diagnostics.Tracing.TraceEvent">
      <HintPath>..\Microsoft.Diagnostics.Tracing.TraceEvent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Diagnostics.FastSerialization">
      <HintPath>..\Microsoft.Diagnostics.FastSerialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OSExtensions">
      <HintPath>..\OSExtensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    单文件发布：把依赖作为嵌入资源打进 exe，由 Embedded.cs 里的 Boot 在运行时取出。

    分两类处理（这一点踩过大坑）：
      · 纯托管依赖 → 直接从内存 Assembly.Load(byte[])
      · OSExtensions.dll → 必须解包到磁盘再 Assembly.LoadFrom。
        它要靠原生 KernelTraceControl.dll 才能启动内核会话，从内存加载时
        Assembly.Location 是空字符串，拼不出 amd64\ 路径，追踪会直接失败
        （报「路径中具有非法字符」），所以原生 amd64\ 整包也要一起嵌入。

    LogicalName 必须显式指定，否则会被加上 RootNamespace 前缀，运行时按名字找不到。
    原生文件用 native_amd64_ 前缀，解包时映射到 amd64\ 子目录。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Microsoft.Diagnostics.Tracing.TraceEvent.dll">
      <LogicalName>Microsoft.Diagnostics.Tracing.TraceEvent.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Microsoft.Diagnostics.FastSerialization.dll">
      <LogicalName>Microsoft.Diagnostics.FastSerialization.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\OSExtensions.dll">
      <LogicalName>OSExtensions.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\System.Runtime.CompilerServices.Unsafe.dll">
      <LogicalName>System.Runtime.CompilerServices.Unsafe.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Dia2Lib.dll">
      <LogicalName>Dia2Lib.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\TraceReloggerLib.dll">
      <LogicalName>TraceReloggerLib.dll</LogicalName>
    </EmbeddedResource>

    <!-- 原生：内核会话必需，缺一个就会「空白」 -->
    <EmbeddedResource Include="..\amd64\KernelTraceControl.dll">
      <LogicalName>native_amd64_KernelTraceControl.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\amd64\msdia140.dll">
      <LogicalName>native_amd64_msdia140.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\amd64\msvcp140.dll">
      <LogicalName>native_amd64_msvcp140.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\amd64\vcruntime140.dll">
      <LogicalName>native_amd64_vcruntime140.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\amd64\vcruntime140_1.dll">
      <LogicalName>native_amd64_vcruntime140_1.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
