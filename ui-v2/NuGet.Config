<?xml version="1.0" encoding="utf-8"?>
<!--
  本机 %APPDATA%\NuGet\NuGet.Config 里的 packageSources 是空的（会覆盖默认的 nuget.org），
  所以在这里显式 <clear /> 掉继承来的空列表并补回官方源，保证 ui-v2 可以独立还原。
  只用于还原 Microsoft.NETFramework.ReferenceAssemblies（约 100KB），不引入运行时依赖。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
